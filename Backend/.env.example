NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=replace-with-a-long-random-secret

# These limits use process-local memory and support only one persistent backend process.
# Use a shared store before multi-instance deployment. Configure trust proxy only for the known production proxy topology.
IOT_RATE_LIMIT_WINDOW_MS=60000
IOT_INGRESS_RATE_LIMIT=300
IOT_DEVICE_RATE_LIMIT=120

IOT_SIM_BASE_URL=http://localhost:3000
IOT_SIM_INTERVAL_MS=5000
IOT_SIM_S01_KEY=
IOT_SIM_S02_KEY=
IOT_SIM_S03_KEY=
IOT_SIM_S04_KEY=
IOT_SIM_S05_KEY=
