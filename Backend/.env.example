NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=480
OUTPUT_LOSS_FALLBACK_PIECES_PER_MINUTE=0.05
API_REQUEST_TIMEOUT_MS=12000
HEALTH_READINESS_TIMEOUT_MS=2000
SERVER_SHUTDOWN_TIMEOUT_MS=10000

# These limits use process-local memory and support only one persistent backend process.
# Use a shared store before multi-instance deployment. Configure trust proxy only for the known production proxy topology.
IOT_RATE_LIMIT_WINDOW_MS=60000
IOT_INGRESS_RATE_LIMIT=300
IOT_DEVICE_RATE_LIMIT=120

# Report export throttling (per authenticated user)
EXPORT_RATE_LIMIT_WINDOW_MS=60000
EXPORT_RATE_LIMIT=10

# Device heartbeat and watchdog timing. Keep the expected heartbeat shorter than
# stale-after, the watchdog tick shorter than stale-after, and its timeout shorter than its tick.
IOT_HEARTBEAT_EXPECTED_INTERVAL_MS=10000
IOT_HEARTBEAT_STALE_AFTER_MS=30000
WATCHDOG_MODE=disabled
WATCHDOG_TICK_INTERVAL_MS=5000
WATCHDOG_EVALUATION_TIMEOUT_MS=4000

# SSE authorization and resource controls are process-local. A shared registry and
# cross-instance event broker are required before running multiple backend instances.
SSE_HEARTBEAT_INTERVAL_MS=30000
SSE_AUTH_REVALIDATION_INTERVAL_MS=60000
SSE_AUTH_REVALIDATION_TIMEOUT_MS=5000
SSE_BACKPRESSURE_TIMEOUT_MS=60000
SSE_MAX_CONNECTION_LIFETIME_MS=3600000
# Alerts plus downtime use two connections per dashboard tab. These defaults
# support two tabs per user and several users behind one shared LAN/NAT address.
SSE_MAX_CONNECTIONS_PER_USER=4
SSE_MAX_CONNECTIONS_PER_IP=20
SSE_MAX_CONNECTIONS_TOTAL=100
SSE_MAX_PENDING_EVENTS=100
SSE_MAX_PENDING_BYTES=262144
SSE_TCP_KEEPALIVE_INITIAL_DELAY_MS=30000

IOT_SIM_BASE_URL=http://localhost:3000
IOT_SIM_INTERVAL_MS=5000
IOT_SIM_S01_KEY=
IOT_SIM_S02_KEY=
IOT_SIM_S03_KEY=
IOT_SIM_S04_KEY=
IOT_SIM_S05_KEY=
IOT_SIM_BOOT_COUNTER=1

# Temporary Brevo development key. Keep the real value only in Backend/.env.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Petro Hydro Monitoring
# Browser origin used in password-setup emails; use HTTPS for deployment.
ACCOUNT_SETUP_ORIGIN=http://localhost:5173
