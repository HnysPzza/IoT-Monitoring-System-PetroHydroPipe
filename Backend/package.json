{
  "name": "iot-monitoring-backend",
  "version": "1.0.0",
  "description": "Express API for the PetroHydroPipe IoT monitoring system.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js tests/contracts/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:verify:downtime": "node scripts/verify-downtime-migration.js",
    "iot:keys": "node scripts/generate-device-keys.js",
    "iot:simulate:once": "node scripts/simulate-sensor-events.js --once",
    "iot:simulate:verify": "node scripts/simulate-sensor-events.js --verify-sensor=S-04",
    "iot:simulate": "node scripts/simulate-sensor-events.js",
    "iot:heartbeat:once": "node scripts/simulate-heartbeats.js --once",
    "iot:heartbeat": "node scripts/simulate-heartbeats.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "nodemon": "^3.1.14"
  }
}
